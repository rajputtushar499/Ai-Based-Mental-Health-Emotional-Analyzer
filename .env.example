# Copy this file to ".env" and change the values.
SECRET_KEY=change-this-secret-key
DATABASE_URL=sqlite:///mental_health.db

# Debug mode (never enable on a public server)
FLASK_DEBUG=false

# Hugging Face models (downloaded automatically on first run, then cached)
TEXT_MODEL_ID=bhadresh-savani/distilbert-base-uncased-emotion
SPEECH_MODEL_ID=superb/wav2vec2-base-superb-er

# Force demo predictions for text (no model is loaded). Demo results are always labelled "demo".
DEMO_MODE=false
# If the text model cannot be loaded (e.g. no internet), fall back to labelled demo predictions.
ALLOW_DEMO_FALLBACK=true
# Load models when the server starts (recommended)
LOAD_MODELS_ON_START=true

# Comma separated list of allowed CORS origins for /api/*
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Set to true only when serving over HTTPS
SESSION_COOKIE_SECURE=false
